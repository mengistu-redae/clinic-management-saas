# Copy to .env and adjust for local development. docker-compose reads .env
# automatically; every value below already has the same default baked into
# docker-compose.yml, so this file is optional except for BFF_CLIENT_SECRET.

POSTGRES_USER=clinicops
POSTGRES_PASSWORD=clinicops

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# realm-export.json doesn't set an explicit secret for the confidential
# "clinic-bff" client, so Keycloak generates a random one on import - the
# "changeme-in-keycloak-console" default will NOT work as-is. After
# `docker compose up`, open http://localhost:8080 -> master realm admin
# console -> clinic realm -> Clients -> clinic-bff -> Credentials tab, copy
# the client secret shown there, put it here, then
# `docker compose up -d --force-recreate node-bff`.
BFF_CLIENT_SECRET=changeme-in-keycloak-console

# Any long random string - only needs to be stable for as long as you want
# existing sessions to survive a restart.
SESSION_SECRET=changeme-long-random-string
